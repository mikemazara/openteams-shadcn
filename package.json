{
  "name": "@openteams/registry",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTeams component registry — install with: npx shadcn add @openteams/<name>",
  "type": "module",
  "packageManager": "bun@1.2.0",
  "scripts": {
    "build": "shadcn build --output public/r",
    "registry:build": "shadcn build --output public/r",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o public",
    "site:build": "storybook build -o public && shadcn build --output public/r",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint --fix . --cache --cache-location .eslintcache",
    "format:check": "prettier --check \"registry/**/*.{ts,tsx,json,md}\"",
    "format:write": "prettier --write \"registry/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:write && bun run lint:fix && bun run typecheck",
    "ci": "bun run lint && bun run format:check && bun run typecheck"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.6.1",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^59.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.10.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.49.0",
    "vite": "^8.0.16"
  }
}