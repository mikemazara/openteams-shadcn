{
  "name": "@openteams/registry",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTeams component registry — install with: npx shadcn add @openteams/<name>",
  "type": "module",
  "packageManager": "bun@1.2.0",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o public",
    "registry:build": "shadcn build --output public/r",
    "site:build": "storybook build -o public && shadcn build --output public/r"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "shadcn": "^4.10.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.16"
  }
}
