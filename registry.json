    {
      "name": "skeleton",
      "type": "registry:ui",
      "title": "Skeleton",
      "description": "Loading placeholder.",
      "registryDependencies": ["@openteams/utils"],
      "files": [
        { "path": "registry/openteams/ui/skeleton.tsx", "type": "registry:ui" }
      ]
    }
  ]
}
