{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "openteams",
  "homepage": "https://mikemazara.github.io/openteams-shadcn",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn() utility",
      "description": "Class name merge helper used by every component.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "registry/openteams/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "OpenTeams theme",
      "description": "Brand color tokens and radius. Edit here to restyle every component at once.",
      "cssVars": {
        "theme": {
          "radius": "0.625rem"
        },
        "light": {
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0% 0 0)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0% 0 0)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0% 0 0)",
          "primary": "#8232AA",
          "primary-foreground": "#ffffff",
          "secondary": "oklch(0.97 0 0)",
          "secondary-foreground": "oklch(0.205 0 0)",
          "muted": "oklch(0.96 0.005 285)",
          "muted-foreground": "oklch(0.52 0.02 285)",
          "accent": "oklch(0.97 0 0)",
          "accent-foreground": "oklch(0.205 0 0)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "destructive-foreground": "oklch(0.97 0.01 17)",
          "border": "oklch(0.922 0 0)",
          "input": "oklch(0.922 0 0)",
          "ring": "#8232AA"
        },
        "dark": {
          "background": "oklch(0.145 0 0)",
          "foreground": "oklch(0.985 0 0)",
          "card": "oklch(0.205 0 0)",
          "card-foreground": "oklch(0.985 0 0)",
          "popover": "oklch(0.205 0 0)",
          "popover-foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.922 0 0)",
          "primary-foreground": "oklch(0.205 0 0)",
          "secondary": "oklch(0.269 0 0)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.269 0 0)",
          "muted-foreground": "oklch(0.708 0 0)",
          "accent": "oklch(0.371 0 0)",
          "accent-foreground": "oklch(0.985 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "destructive-foreground": "oklch(0.58 0.22 27)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.556 0 0)"
        }
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Button with variants and sizes.",
      "dependencies": ["class-variance-authority", "radix-ui"],
      "registryDependencies": ["@openteams/utils", "@openteams/spinner"],
      "files": [
        { "path": "registry/openteams/ui/button.tsx", "type": "registry:ui" }
      ]
    },
    {
      "name": "spinner",
      "type": "registry:ui",
      "title": "Spinner",
